# ── FRED API (free) ───────────────────────────────────────────────────────────
# Sign up at: https://fred.stlouisfed.org/docs/api/api_key.html
# Takes ~30 seconds to get a key
FRED_API_KEY=your_fred_api_key_here

# ── Alert sensitivity ─────────────────────────────────────────────────────────
# Fire an alert when any series moves this % week-over-week
ALERT_THRESHOLD_PCT=5.0

# ── Data window ───────────────────────────────────────────────────────────────
HISTORY_DAYS=365

# ── Paths ─────────────────────────────────────────────────────────────────────
DB_PATH=freight_data.db
DASHBOARD_OUTPUT=dashboard.html
